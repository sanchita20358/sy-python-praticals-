\pard\sa200\sl276\slmult1 code:\par
\fs24 marks=[]\par
\par
while True:\par
    print("\\n===STUDENT MARKS MANAGEMENT SYSTEM====")\par
    print("1. Insert marks:")\par
    print("2. display marks:")\par
    print("3. update marks:")\par
    print("4. delete marks:")\par
    print("5.exit")\par
\par
    choice=int(input("Enter your choice:"))\par
\par
    if choice==1:\par
        mark=int(input("Enter student marks:"))\par
        marks.append(mark)\par
        print("Marks inserted successfully")\par
    elif choice==2:\par
        if len(marks)==0:\par
            print("No marks available")\par
        else:\par
            print("Student Marks:")\par
            for i in range(len(marks)):\par
                print("Student",i+1,":",marks[i])\par
    elif choice==3:\par
        student=int(input("Enter student number to update:"))\par
        if i<=student<=len(marks):\par
            new_mark=int(input("Enter new marks:")) \par
            marks[student-1]=new_mark\par
            print("Marks updated successfully")\par
        else:\par
            print("Invalid student number")\par
\par
    elif choice==4:\par
            student=int(input("Enter student number to delete:"))\par
            if i<=student<=len(marks): \par
              marks.pop(student-1)\par
              print("Marks deleted successfully")\par
            else:\par
                print("Invalid student number")\par
\par
    elif choice==5:\par
        print("Program ended")\par
        break\par
    else:\par
        print("Invalid choice")\par
                   \par
    \fs28 output:    \par

